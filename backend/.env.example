# MongoDB Configuration - Use MongoDB Atlas for cloud deployment
# Local: mongodb://localhost:27017/helpdeskdb
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/database-name
MONGO_URI=mongodb://localhost:27017/smart-helpdesk

# Redis Configuration - Use Upstash for cloud deployment
# Local Redis: Leave empty or use localhost:6379
# Upstash URL format: rediss://default:password@hostname.upstash.io:port
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secret - Keep this secure!
